// MemberFrame database schema. MySQL 8.0+ via Prisma.
//
// Mirrors `docs/memberframe-backend-prd.md` section 5 and the entity list in
// the main PRD section 11.1. Only the tables the implemented routes need are
// declared: the repo's own rule is to declare nothing preemptively, the same way
// `framer.json` adds a permission in the task that first needs it.
//
// THREE THINGS PRISMA CANNOT EXPRESS, handled in `migrations/` by hand:
//
//   1. The email column collation. MySQL 8's default collation is case
//      insensitive, which is what `CITEXT` gave us for free, but it is also
//      ACCENT insensitive, which would make jose@x.com and the accented
//      spelling the same mailbox. They are not. Pinned to utf8mb4_0900_as_ci.
//
//   2. The `active_email` generated column and its unique index. PRD section
//      11.2 wants soft delete plus unique email per site, which PostgreSQL does
//      with a partial index. MySQL has no partial indexes, and the obvious
//      workaround is wrong: a unique key over (site_id, email, deleted_at)
//      allows unlimited active duplicates, because MySQL treats every NULL in
//      a unique index as distinct.
//
//   3. `ON DELETE CASCADE` ordering for the self-referential cases, which there
//      are none of yet. Noted so the next person does not look for it.
//
// Run `npm run db:migrate` after editing. The hand-written SQL lives in its own
// migration so `prisma migrate dev` never overwrites it.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// CREATORS AND TENANTS
// ============================================================================

/// A MemberFrame customer. Owns Framer projects and pays us.
///
/// Distinct from `Member`, which is a visitor to one of their sites and pays
/// THEM. Backend PRD section 3.3 keeps the two apart: a human can be both, and
/// those are unrelated rows with unrelated passwords.
model User {
  // uuid(7) rather than uuid(4). MySQL InnoDB clusters rows by primary key and
  // copies the key into every secondary index, so a random v4 scatters inserts
  // across pages and fragments the index. v7 is time ordered, so inserts
  // append. Needs Prisma 5.18 or newer.
  id              String    @id @default(uuid(7)) @db.Char(36)
  name            String    @db.VarChar(255)
  email           String    @unique @db.VarChar(255)
  emailVerifiedAt DateTime? @map("email_verified_at") @db.DateTime(3)
  /// Nullable since the connect flow. A creator who arrived through the plugin
  /// proved an address by email code and never chose a password, so there is
  /// nothing to store. Same reasoning as Member.passwordHash, and the same
  /// rule: NULL is a failed credential check, never a bypass.
  passwordHash    String?   @map("password_hash") @db.VarChar(255)

  /// What `framer.getCurrentUser()` can supply. Nullable and NOT unique:
  /// blocker B7 records that the SDK exposes no email, so a creator arriving
  /// through the plugin cannot be matched to an account by address. The join
  /// stays best effort until B7 is resolved.
  framerUserId String? @map("framer_user_id") @db.VarChar(255)

  /// From Google sign in on the hosted account page (F19). Shown on Account.
  avatarUrl String? @map("avatar_url") @db.VarChar(1000)
  /// Google's stable subject id, so a changed Gmail address still finds the account.
  googleId  String? @unique @map("google_id") @db.VarChar(255)
  /// The creator's customer in MemberFrame's own Stripe account (F19), reused
  /// for every plan they buy, on any of their projects.
  stripeCustomerId String? @unique @map("stripe_customer_id") @db.VarChar(255)

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  sites    Site[]
  sessions CreatorSession[]
  handoffs CreatorAuthHandoff[]

  @@index([framerUserId])
  @@map("users")
}

/// The tenant. One Framer project.
///
/// Every member, tier, and session row carries `siteId`, and no query may omit
/// it. Backend PRD section 3.1 enforces that in three layers.
model Site {
  id       String @id @default(uuid(7)) @db.Char(36)
  userId   String @map("user_id") @db.Char(36)
  siteName String @map("site_name") @db.VarChar(255)

  /// Public. Baked into each generated canvas component, exactly like
  /// `apiBaseUrl` already is, and no more secret than a Stripe publishable key.
  ///
  /// It identifies; the `Origin` header verifies. Backend PRD section 3.2, and
  /// the resolution of conflict C17, where three documents disagreed on how a
  /// request names its tenant.
  siteKey String @unique @map("site_key") @db.VarChar(64)

  /// Exact origins. No wildcards, ever. See `middleware/cors.ts` for why a
  /// wildcard is not merely unwise here but non-functional: the CORS spec makes
  /// `Allow-Credentials: true` and `Allow-Origin: *` mutually exclusive.
  allowedOrigins Json @map("allowed_origins")

  /// The Framer project id from framer.getProjectInfo(). Unique, because one
  /// Framer project is one tenant: a second connect attempt for the same
  /// project must find this row rather than make another. MySQL treats every
  /// NULL in a unique index as distinct, so a site created some other way and
  /// never connected does not occupy the slot.
  framerSiteId String? @unique @map("framer_site_id") @db.VarChar(255)

  /// Per-site salt for F22 shared-password grants. Rotating it invalidates
  /// every outstanding grant for this site and nothing else.
  grantSalt String @map("grant_salt") @db.Char(64)

  sharedPasswordHash String? @map("shared_password_hash") @db.VarChar(255)
  defaultLocale      String  @default("en") @map("default_locale") @db.VarChar(10)

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  settings       SiteSettings?
  tiers          Tier[]
  members        Member[]
  otps           MemberOtp[]
  passwordResets MemberPasswordReset[]
  emailLogs      EmailLog[]
  paymentSettings PaymentSettings?
  gatewayConfigs  GatewayConfig[]
  subscriptions   Subscription[]
  /// FP-12
  assets          Asset[]
  outboundWebhooks OutboundWebhook[]
  /// F19: what this project pays MemberFrame.
  pluginSubscriptions PluginSubscription[]

  @@index([userId])
  @@map("sites")
}

// ============================================================================
// TIERS
// ============================================================================

/// A membership plan.
///
/// `rank` is the field `isEntitled` compares, which makes its uniqueness the
/// most consequential constraint in this schema. Two tiers sharing a rank makes
/// a Gold member and a Silver member identical to every gate on the site, with
/// no error raised anywhere.
///
/// The unique key is unconditional and includes inactive tiers, because the
/// resolver looks a tier up by key without checking `isActive`.
model Tier {
  id     String @id @default(uuid(7)) @db.Char(36)
  siteId String @map("site_id") @db.Char(36)

  /// free_member, tier_1, tier_2, vip, or a creator-defined key. Conflict C9:
  /// the gate's control is a fixed enum of four until the generator can read
  /// this table and emit the site's real keys.
  key  String @db.VarChar(50)
  name String @db.VarChar(100)
  rank Int

  // Integer minor units. PRD section 11.2: floating point currency produces
  // rounding errors. 1900 is $19.00.
  monthlyPriceMinor  Int? @map("monthly_price_minor")
  annualPriceMinor   Int? @map("annual_price_minor")
  lifetimePriceMinor Int? @map("lifetime_price_minor")

  currency String  @default("USD") @db.Char(3)
  isActive Boolean @default(true) @map("is_active")

  /// What the tier includes, shown on its pricing card: [{ text, included }].
  /// memberframe/docs/development-docs/28-tier-features.md
  features Json?

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  site        Site        @relation(fields: [siteId], references: [id], onDelete: Cascade)
  /// FP-16. Prices in other currencies than `currency`, e.g. INR for Razorpay.
  extraPrices TierPrice[]

  @@unique([siteId, key], map: "uniq_tiers_site_key")
  @@unique([siteId, rank], map: "uniq_tiers_site_rank")
  @@map("tiers")
}

// ============================================================================
// MEMBERS
// ============================================================================

model Member {
  id     String @id @default(uuid(7)) @db.Char(36)
  siteId String @map("site_id") @db.Char(36)

  /// Unique per site, not globally. PRD section 11.2: the same person may be a
  /// member of two different creators' sites.
  ///
  /// The unique index is NOT declared here. It is on the generated
  /// `active_email` column, added by hand in
  /// `migrations/*_mysql_specifics/migration.sql`, so that a soft-deleted
  /// member stops occupying their address and can re-register.
  email String @db.VarChar(255)

  emailVerifiedAt DateTime? @map("email_verified_at") @db.DateTime(3)
  name            String?   @db.VarChar(255)
  avatarUrl       String?   @map("avatar_url") @db.Text

  /// Nullable, and that is load bearing.
  ///
  /// A member who signed up with Google has no password. The sign-in path must
  /// treat NULL as a failed credential check, never as a bypass and never as a
  /// distinguishable error, because the difference is a user-enumeration
  /// oracle. See `services/memberAuthService.ts`.
  passwordHash      String?   @map("password_hash") @db.VarChar(255)
  passwordUpdatedAt DateTime? @map("password_updated_at") @db.DateTime(3)

  activeTier String @default("free_member") @map("active_tier") @db.VarChar(50)

  /// active, trialing, past_due, canceled. A string rather than a MySQL enum:
  /// adding a value to a MySQL enum is an ALTER TABLE, and `isEntitled` already
  /// treats an unrecognised status as not entitled, which fails closed.
  status String @default("active") @db.VarChar(20)

  /// FP-09 custom profile fields. One JSON column rather than a table per
  /// creator-defined field, which would mean schema migrations driven by
  /// creator input. See `00-member-data-model.md` section 5.4.
  metadata Json? @db.Json

  // FP-02 lockout. Five consecutive failures, fifteen minutes, counted per
  // member and cleared on success.
  failedLoginCount Int       @default(0) @map("failed_login_count")
  lockedUntil      DateTime? @map("locked_until") @db.DateTime(3)
  lastLoginAt      DateTime? @map("last_login_at") @db.DateTime(3)

  /// How the account was created: email, google, apple, github, discord, or
  /// added (by the creator). NULL for members from before 2026-10-23.
  /// 31-sign-in-methods.md.
  signupMethod String? @map("signup_method") @db.VarChar(20)

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  /// Soft delete, per PRD section 11.2, to preserve invoice history.
  deletedAt DateTime? @map("deleted_at") @db.DateTime(3)

  site           Site                  @relation(fields: [siteId], references: [id], onDelete: Cascade)
  sessions       MemberSession[]
  passwordResets MemberPasswordReset[]
  subscriptions  Subscription[]
  /// FP-10
  bookmarks      Bookmark[]
  /// FP-07, one row while signed in
  meterCycle     MeterCycle?
  /// The social sign ins linked to this account. 31-sign-in-methods.md.
  identities     MemberIdentity[]

  @@index([siteId, status])
  @@index([siteId, activeTier])
  @@index([lockedUntil])
  @@map("members")
}

/// One social sign in linked to a member: the provider and the provider's own
/// stable user id (Google and Apple `sub`, GitHub and Discord `id`). Found by
/// that id first, so a member who changes their email at the provider still
/// reaches the same account. 31-sign-in-methods.md.
model MemberIdentity {
  id             String   @id @default(uuid(7)) @db.Char(36)
  siteId         String   @map("site_id") @db.Char(36)
  memberId       String   @map("member_id") @db.Char(36)
  /// google, apple, github, discord
  provider       String   @db.VarChar(20)
  providerUserId String   @map("provider_user_id") @db.VarChar(191)
  /// The address the provider gave at the last sign in.
  email          String   @db.VarChar(255)
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(3)
  lastUsedAt     DateTime @default(now()) @map("last_used_at") @db.DateTime(3)

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([siteId, provider, providerUserId])
  @@index([memberId])
  @@map("member_identities")
}

/// An opaque server-side session.
///
/// Not a JWT. PRD section 14.1 S2 forbids a token in `localStorage`, and the
/// canvas components are written so they never see one. An opaque row also
/// makes revocation a DELETE rather than a wait for expiry, which is what lets
/// a password reset invalidate every other session.
///
/// Only the hash is stored. A database read does not hand over live sessions.
model MemberSession {
  id        String @id @default(uuid(7)) @db.Char(36)
  memberId  String @map("member_id") @db.Char(36)
  siteId    String @map("site_id") @db.Char(36)
  tokenHash String @unique @map("token_hash") @db.VarChar(255)

  /// Diagnostics only. Never used to authorize: an IP changes mid-session on
  /// mobile, and pinning a session to one would log members out on the train.
  userAgent String? @map("user_agent") @db.VarChar(512)
  ipAddress String? @map("ip_address") @db.VarChar(45)

  expiresAt  DateTime  @map("expires_at") @db.DateTime(3)
  revokedAt  DateTime? @map("revoked_at") @db.DateTime(3)
  lastSeenAt DateTime? @map("last_seen_at") @db.DateTime(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.DateTime(3)

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
  @@index([expiresAt])
  @@map("member_sessions")
}

/// FP-02 password reset. Hashed, single use, fifteen minutes.
///
/// The token in the emailed URL is the only copy that exists in plaintext, and
/// it exists there because FP-02 section 2.3 puts it in a query string. See
/// `05-member-auth.md` section 9.6 for what that costs and what the component
/// does about it.
model MemberPasswordReset {
  id        String @id @default(uuid(7)) @db.Char(36)
  siteId    String @map("site_id") @db.Char(36)
  memberId  String @map("member_id") @db.Char(36)
  tokenHash String @unique @map("token_hash") @db.VarChar(255)

  expiresAt  DateTime  @map("expires_at") @db.DateTime(3)
  consumedAt DateTime? @map("consumed_at") @db.DateTime(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.DateTime(3)

  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
  @@index([expiresAt])
  @@map("member_password_resets")
}

/// A six-digit code. Hashed at rest.
///
/// Keyed by email rather than by member, because a code can be requested for an
/// address that has no account yet: the OTP path doubles as sign-up. That also
/// means this table must never reveal whether the address is registered.
model MemberOtp {
  id     String @id @default(uuid(7)) @db.Char(36)
  siteId String @map("site_id") @db.Char(36)
  email  String @db.VarChar(255)

  codeHash String @map("code_hash") @db.VarChar(255)

  /// Three verification attempts, then the code is dead. F05 requires a fourth
  /// attempt to be rejected AND the code invalidated.
  attempts Int @default(0)

  expiresAt         DateTime  @map("expires_at") @db.DateTime(3)
  resendAvailableAt DateTime  @map("resend_available_at") @db.DateTime(3)
  consumedAt        DateTime? @map("consumed_at") @db.DateTime(3)
  createdAt         DateTime  @default(now()) @map("created_at") @db.DateTime(3)

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, email, expiresAt])
  @@index([expiresAt])
  @@map("member_otps")
}

/// Every message the API tried to send.
///
/// Exists mainly so the flows are testable without an SMTP account: the `log`
/// mail driver writes here and to a file, so a developer can read the OTP or
/// the reset link during the cookie spike in backend PRD section 2.3 without
/// configuring a provider.
///
/// It stores the SUBJECT and the recipient, never the body. A reset link in a
/// database row is a reset link an operator can use.
model EmailLog {
  id     String  @id @default(uuid(7)) @db.Char(36)
  siteId String? @map("site_id") @db.Char(36)

  toAddress String  @map("to_address") @db.VarChar(255)
  subject   String  @db.VarChar(255)
  template  String  @db.VarChar(64)
  driver    String  @db.VarChar(32)
  messageId String? @map("message_id") @db.VarChar(255)

  sentAt DateTime? @map("sent_at") @db.DateTime(3)
  error  String?   @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  site Site? @relation(fields: [siteId], references: [id], onDelete: SetNull)

  @@index([toAddress, createdAt])
  @@map("email_logs")
}

// ============================================================================
// SITE SETTINGS: ONE JSON DOCUMENT, NOT A COLUMN PER SWITCH
// ============================================================================

/// Everything a creator configures about one site, as a single JSON document.
///
/// A deliberate instruction, and the right one. The alternative is a column per
/// setting, and this product adds settings continuously: a login path, a
/// redirect, an auth method, a locale, a from-address. Each would be an
/// ALTER TABLE on a table holding a row per customer, and a deploy window where
/// the code expects a column the database does not have yet.
///
/// What is given up is real, and worth stating rather than discovering:
///
///   1. **The database no longer validates the shape.** Nothing stops a null
///      where a boolean belongs. lib/siteSettings.ts is therefore the only
///      writer: it validates on the way in and fills defaults on the way out,
///      so a row written by an older version still reads.
///   2. **A setting cannot be indexed or queried across sites.** "Which sites
///      allow registration" is a full scan. Nothing asks that today. A setting
///      that needs to be queried should be promoted to its own column, which is
///      a migration rather than a redesign.
///   3. **Concurrent writes are last-write-wins.** Two plugin panels open on one
///      project would overwrite each other. "version" makes that detectable: a
///      write carrying a stale version is refused instead of silently winning.
///
/// Keyed by site_id and nothing else: one row per site, created with the site,
/// so a read never has to handle "no row yet".
model SiteSettings {
  siteId String @id @map("site_id") @db.Char(36)

  /// The whole document. Shape and defaults in lib/siteSettings.ts, which owns
  /// SETTINGS_SCHEMA_VERSION and upgrades an older document on read.
  ///
  /// NEVER a secret. Gateway keys live encrypted in their own table (backend
  /// PRD phase B3) because this document is returned to the panel whole.
  settings Json @db.Json

  /// Bumped on every write. See the note above.
  version Int @default(1)

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@map("site_settings")
}

// ============================================================================
// CREATOR IDENTITY
// ============================================================================
// Conflict C10 closes here. Every /api/site/* route needed a creator session
// and no task in the 72-task plan built one, so the plugin's Manage and
// Settings tabs have been signed out since the project began.
//
// The creator proves an address with a six-digit code, exactly as a member
// does, and gets an opaque session token. Separate tables from the member ones
// throughout: a creator and a member are different principals with very
// different blast radii, and sharing a table is how a member session ends up
// accepted on a creator route.

/// A six-digit code sent to a creator's address during connect.
///
/// Not keyed to a user row, because the address may have no account yet: the
/// connect flow doubles as sign-up. Which also means this table must never
/// reveal whether an address is already registered.
model CreatorOtp {
  id    String @id @default(uuid(7)) @db.Char(36)
  email String @db.VarChar(255)

  codeHash String @map("code_hash") @db.VarChar(255)

  /// Three attempts, then dead, matching the member OTP. A fourth attempt is
  /// rejected AND invalidates the code, so guessing cannot be extended.
  attempts Int @default(0)

  /// What the code is for, carried through verification so a code minted for
  /// one Framer project cannot be used to claim another.
  framerProjectId String @map("framer_project_id") @db.VarChar(255)

  expiresAt         DateTime  @map("expires_at") @db.DateTime(3)
  resendAvailableAt DateTime  @map("resend_available_at") @db.DateTime(3)
  consumedAt        DateTime? @map("consumed_at") @db.DateTime(3)
  createdAt         DateTime  @default(now()) @map("created_at") @db.DateTime(3)

  @@index([email, framerProjectId, expiresAt])
  @@index([expiresAt])
  @@map("creator_otps")
}

/// An opaque creator session, held by the plugin panel.
///
/// Sent as "Authorization: Bearer", not as a cookie, and that is what makes the
/// panel work at all: the panel is an iframe on an origin we do not control, so
/// a cross-site cookie there would hit exactly the Safari and Firefox blocking
/// that backend PRD section 2.3 calls the project's largest risk. A bearer
/// header has no such problem, and a request carrying no cookie cannot be
/// CSRF'd, which is why the creator API needs no CSRF token.
///
/// Only the hash is stored, as everywhere else.
model CreatorSession {
  id        String @id @default(uuid(7)) @db.Char(36)
  userId    String @map("user_id") @db.Char(36)
  tokenHash String @unique @map("token_hash") @db.VarChar(255)

  /// Diagnostics only, never used to authorize. See MemberSession.
  userAgent String? @map("user_agent") @db.VarChar(512)
  ipAddress String? @map("ip_address") @db.VarChar(45)

  expiresAt  DateTime  @map("expires_at") @db.DateTime(3)
  revokedAt  DateTime? @map("revoked_at") @db.DateTime(3)
  lastSeenAt DateTime? @map("last_seen_at") @db.DateTime(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("creator_sessions")
}

// ============================================================================
// NOT DECLARED YET, AND DELIBERATELY
// ============================================================================
// Each arrives with the feature that needs it, so the schema never carries a
// table nothing reads:
//
//   custom_fields                              FP-09
//   assets, asset_grants                       FP-12
//   course_progress                            FP-11
//   bookmarks                                  FP-10
//   organizations, seat_invites                F12
//   metered_sessions                           FP-07
//   (plugin_trials arrived with F19, below)

// ============================================================================
// PAYMENTS. Feature plan FP-16, backend PRD phase B3
// ============================================================================
// Money moves from a buyer straight into the creator's own gateway account.
// These tables hold the creator's encrypted keys, what was sold, and the
// ledger that makes webhooks idempotent. There is no fee column anywhere, and
// a test keeps it that way: PRD F03, "No fee line item exists in the codebase".

/// One row per site. Payment behaviour the creator configures.
model PaymentSettings {
  siteId String @id @map("site_id") @db.Char(36)

  /// test or live. Which set of gateway keys a checkout uses. New sites start
  /// in test, so a first purchase can never take real money by accident.
  mode String @default("test") @db.VarChar(8)

  /// stripe, lemonsqueezy, razorpay, or empty for "the first connected one".
  defaultGateway String @default("") @map("default_gateway") @db.VarChar(20)

  autoDetectGeolocation Boolean @default(true) @map("auto_detect_geolocation")
  defaultCurrency       String  @default("USD") @map("default_currency") @db.Char(3)

  /// F18. How long a failed renewal keeps access before it ends.
  graceDays Int @default(3) @map("grace_days")

  /// Site-relative paths, checked by `isSafeSitePath` before they are stored.
  afterPurchasePath String @default("/dashboard") @map("after_purchase_path") @db.VarChar(255)
  pricingPath       String @default("/pricing") @map("pricing_path") @db.VarChar(255)

  /// The checkout chooser's title and description per gateway, overriding the
  /// defaults in lib/methodLabels.ts (29-checkout-methods.md).
  methodLabels Json? @map("method_labels")

  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@map("payment_settings")
}

/// A creator's keys for one gateway in one mode. Secrets are AES-256-GCM
/// (`lib/secretBox.ts`) and no read shape in this codebase carries them.
model GatewayConfig {
  id      String @id @default(uuid(7)) @db.Char(36)
  siteId  String @map("site_id") @db.Char(36)
  gateway String @db.VarChar(20)
  mode    String @db.VarChar(8)

  /// Safe to show: Razorpay key id, Lemon Squeezy store id, Stripe account id.
  publicId String? @map("public_id") @db.VarChar(255)

  /// Encrypted JSON of every secret value, e.g. `{ secretKey }`.
  secretsEncrypted String @map("secrets_encrypted") @db.Text

  /// Encrypted webhook signing secret.
  webhookSecretEncrypted String? @map("webhook_secret_encrypted") @db.Text

  /// The endpoint MemberFrame registered on the gateway, so disconnect can remove it.
  webhookEndpointId String? @map("webhook_endpoint_id") @db.VarChar(255)

  /// Non-secret settings, e.g. Lemon Squeezy variant ids per interval.
  options Json?

  /// Shown to buyers at checkout. Off keeps the keys, and members already
  /// paying through it keep renewing (29-checkout-methods.md).
  enabled Boolean @default(true)

  accountName   String?   @map("account_name") @db.VarChar(255)
  maskedSuffix  String?   @map("masked_suffix") @db.VarChar(8)
  verifiedAt    DateTime? @map("verified_at") @db.DateTime(3)
  lastWebhookAt DateTime? @map("last_webhook_at") @db.DateTime(3)

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, gateway, mode], map: "uniq_gateway_configs_site_gateway_mode")
  @@map("gateway_configs")
}

/// What a gateway charges against for one tier price.
///
/// Keyed by the amount as well as the interval, so changing a tier's price
/// makes a new gateway price and leaves the old one for the members already on
/// it. That is grandfathering, and it falls out of the key rather than code.
model GatewayPrice {
  id          String @id @default(uuid(7)) @db.Char(36)
  siteId      String @map("site_id") @db.Char(36)
  tierKey     String @map("tier_key") @db.VarChar(50)
  interval    String @db.VarChar(10)
  amountMinor Int    @map("amount_minor")
  currency    String @db.Char(3)
  gateway     String @db.VarChar(20)
  mode        String @db.VarChar(8)

  /// Stripe price id, Razorpay plan id.
  externalId        String  @map("external_id") @db.VarChar(255)
  externalProductId String? @map("external_product_id") @db.VarChar(255)

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  @@unique([siteId, tierKey, interval, amountMinor, currency, gateway, mode], map: "uniq_gateway_prices_lookup")
  @@map("gateway_prices")
}

/// A checkout MemberFrame started, and what the return page polls.
model Checkout {
  id         String  @id @default(uuid(7)) @db.Char(36)
  siteId     String  @map("site_id") @db.Char(36)
  memberId   String  @map("member_id") @db.Char(36)
  tierKey    String  @map("tier_key") @db.VarChar(50)
  interval   String  @db.VarChar(10)
  gateway    String  @db.VarChar(20)
  mode       String  @db.VarChar(8)
  externalId String? @map("external_id") @db.VarChar(255)

  /// open, complete, expired, failed
  state      String @default("open") @db.VarChar(10)
  returnPath String @map("return_path") @db.VarChar(255)

  /// What the buyer was quoted, in the currency they were shown. FP-16 section 6.2.
  amountMinor Int?    @map("amount_minor")
  currency    String? @db.Char(3)
  /// A running subscription this purchase replaces, credited for its unused time.
  replacesSubscriptionId String? @map("replaces_subscription_id") @db.Char(36)
  /// The unused credit given off this checkout's first charge, so it is not
  /// refunded again when the replaced plan ends (30-plan-changes.md).
  creditMinor Int? @map("credit_minor")

  createdAt   DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  completedAt DateTime? @map("completed_at") @db.DateTime(3)

  @@index([siteId, memberId])
  @@index([gateway, externalId])
  @@map("checkouts")
}

/// A member's paid access. Lifetime purchases are rows too, with no period end.
model Subscription {
  id       String @id @default(uuid(7)) @db.Char(36)
  siteId   String @map("site_id") @db.Char(36)
  memberId String @map("member_id") @db.Char(36)
  tierKey  String @map("tier_key") @db.VarChar(50)

  /// month, year, lifetime
  interval String @db.VarChar(10)
  gateway  String @db.VarChar(20)
  mode     String @db.VarChar(8)

  /// The gateway's subscription id, or the order or payment id for lifetime.
  externalId         String  @map("external_id") @db.VarChar(255)
  externalCustomerId String? @map("external_customer_id") @db.VarChar(255)

  /// active, past_due, canceling, ended
  status            String    @db.VarChar(12)
  currentPeriodEnd  DateTime? @map("current_period_end") @db.DateTime(3)
  gracePeriodEndsAt DateTime? @map("grace_period_ends_at") @db.DateTime(3)
  cancelAtPeriodEnd Boolean   @default(false) @map("cancel_at_period_end")

  /// A downgrade waiting for the end of the paid period: the plan it switches
  /// to on the next renewal (30-plan-changes.md).
  scheduledTierKey  String? @map("scheduled_tier_key") @db.VarChar(50)
  scheduledInterval String? @map("scheduled_interval") @db.VarChar(10)

  amountMinor Int    @map("amount_minor")
  currency    String @db.Char(3)

  /// Razorpay's hosted page for updating the payment method.
  manageUrl String? @map("manage_url") @db.Text

  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  endedAt   DateTime? @map("ended_at") @db.DateTime(3)

  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([gateway, externalId], map: "uniq_subscriptions_gateway_external")
  @@index([siteId, memberId, status])
  @@index([status, currentPeriodEnd])
  @@index([status, gracePeriodEndsAt])
  @@map("subscriptions")
}

/// Every successful charge, for spend totals and the member's history.
model Payment {
  id             String  @id @default(uuid(7)) @db.Char(36)
  siteId         String  @map("site_id") @db.Char(36)
  memberId       String  @map("member_id") @db.Char(36)
  subscriptionId String? @map("subscription_id") @db.Char(36)
  gateway        String  @db.VarChar(20)
  mode           String  @db.VarChar(8)
  externalId     String  @map("external_id") @db.VarChar(255)
  amountMinor    Int     @map("amount_minor")
  currency       String  @db.Char(3)

  /// paid, refunded
  status     String   @db.VarChar(10)
  receiptUrl String?  @map("receipt_url") @db.Text
  paidAt     DateTime @map("paid_at") @db.DateTime(3)

  @@unique([gateway, externalId], map: "uniq_payments_gateway_external")
  @@index([siteId, memberId])
  @@map("payments")
}

/// The idempotency ledger. Insert before processing; a duplicate insert means
/// the event was already handled and the answer is 200 with no action.
/// Conflict C22: a table, because a cache key can be evicted and a gateway can
/// replay days later.
model WebhookEvent {
  id          String    @id @default(uuid(7)) @db.Char(36)
  gateway     String    @db.VarChar(20)
  eventId     String    @map("event_id") @db.VarChar(255)
  siteId      String?   @map("site_id") @db.Char(36)
  type        String    @db.VarChar(100)
  receivedAt  DateTime  @default(now()) @map("received_at") @db.DateTime(3)
  processedAt DateTime? @map("processed_at") @db.DateTime(3)
  error       String?   @db.Text

  @@unique([gateway, eventId], map: "uniq_webhook_events_gateway_event")
  @@map("webhook_events")
}

/// A tier's price in a currency other than its own. FP-16 section 6.2.
///
/// The tier's three price columns stay its base price list. These rows add the
/// same tier in another currency, so an Indian buyer can be charged a real INR
/// price through Razorpay rather than a converted dollar amount.
model TierPrice {
  id          String @id @default(uuid(7)) @db.Char(36)
  tierId      String @map("tier_id") @db.Char(36)
  currency    String @db.Char(3)
  /// month, year, lifetime
  interval    String @db.VarChar(10)
  amountMinor Int    @map("amount_minor")

  tier Tier @relation(fields: [tierId], references: [id], onDelete: Cascade)

  @@unique([tierId, currency, interval], map: "uniq_tier_prices_tier_currency_interval")
  @@map("tier_prices")
}

/// Sign in provider secrets (Google, GitHub, Apple, Discord client secrets),
/// AES-256-GCM like the gateway keys. The settings document keeps only the
/// non-secret values and a list of which secrets are stored, so the plugin is
/// never sent a client secret again.
model IntegrationSecret {
  siteId           String   @map("site_id") @db.Char(36)
  integrationId    String   @map("integration_id") @db.VarChar(40)
  secretsEncrypted String   @map("secrets_encrypted") @db.Text
  updatedAt        DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  @@id([siteId, integrationId])
  @@map("integration_secrets")
}

// ============================================================================
// ENGAGEMENT AND CONTENT, FP-07, FP-10, FP-12
// ============================================================================

/// FP-10. One saved item per member per slug: the unique key is what makes a
/// rapid double click land once, whatever order the two requests arrive in.
model Bookmark {
  id       String @id @default(uuid(7)) @db.Char(36)
  siteId   String @map("site_id") @db.Char(36)
  memberId String @map("member_id") @db.Char(36)
  itemSlug String @map("item_slug") @db.VarChar(191)
  title    String @db.VarChar(255)
  /// Site-relative path, or an absolute http(s) address. Checked on the way in.
  url      String @db.VarChar(1000)

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, itemSlug], map: "uniq_bookmarks_member_slug")
  @@index([siteId])
  @@map("bookmarks")
}

/// FP-07. The exact meter for a signed-in member, PRD F07: one row, the
/// current cycle's start and the articles counted in it. A visitor who is not
/// signed in is metered on their device instead.
model MeterCycle {
  memberId   String   @id @map("member_id") @db.Char(36)
  siteId     String   @map("site_id") @db.Char(36)
  cycleStart DateTime @map("cycle_start") @db.DateTime(3)
  /// 7 or 30. A change of window starts a new cycle.
  periodDays Int      @map("period_days")
  /// Article slugs counted this cycle, oldest first. Capped at 500.
  slugs      Json
  updatedAt  DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([siteId])
  @@map("meter_cycles")
}

/// FP-12. A protected file. The id is the opaque `assetId` a creator pastes
/// into `<ProtectedDownload>`; the storage key and a linked file's address are
/// server-side only and never sent to a visitor.
model Asset {
  id           String  @id @db.VarChar(40)
  siteId       String  @map("site_id") @db.Char(36)
  name         String  @db.VarChar(200)
  /// What the visitor's browser saves the file as.
  fileName     String  @map("file_name") @db.VarChar(255)
  mimeType     String  @map("mime_type") @db.VarChar(127)
  sizeBytes    BigInt  @default(0) @map("size_bytes")
  /// upload (stored by MemberFrame) or url (a private address MemberFrame fetches).
  source       String  @db.VarChar(10)
  /// local:<path> or s3:<key>, for an upload.
  storageKey   String? @map("storage_key") @db.VarChar(255)
  /// For a linked file. Fetched server side, so it never reaches a visitor.
  remoteUrl    String? @map("remote_url") @db.Text
  /// signed_in, or a tier key. Checked against the member's tier on every sign.
  requiredTier String  @default("signed_in") @map("required_tier") @db.VarChar(50)
  downloadCount Int    @default(0) @map("download_count")
  lastDownloadAt DateTime? @map("last_download_at") @db.DateTime(3)

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId])
  @@map("assets")
}

/// A creator's webhook: member events posted to a third-party URL.
/// Development doc: memberframe/docs/development-docs/20-webhooks.md
model OutboundWebhook {
  id     String @id @default(uuid(7)) @db.Char(36)
  siteId String @map("site_id") @db.Char(36)
  name   String @db.VarChar(100)
  url    String @db.VarChar(1000)
  /// Event types this webhook receives, a JSON array of strings.
  events Json
  /// Tier keys this webhook is limited to. Empty means every plan.
  tiers  Json
  enabled Boolean @default(true)
  /// Custom body: [{ source, key }]. Null sends the standard payload.
  fieldMap Json? @map("field_map")
  /// HMAC signing secret. Stored as is: it can only sign requests to the
  /// creator's own endpoint.
  secret String @db.VarChar(100)

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  site       Site               @relation(fields: [siteId], references: [id], onDelete: Cascade)
  deliveries OutboundDelivery[]

  @@index([siteId])
  @@map("outbound_webhooks")
}

/// One event for one webhook, sent by the worker and retried on failure.
model OutboundDelivery {
  id        String @id @default(uuid(7)) @db.Char(36)
  webhookId String @map("webhook_id") @db.Char(36)
  siteId    String @map("site_id") @db.Char(36)
  event     String @db.VarChar(40)
  payload   Json
  /// pending, delivered, or failed.
  status    String @default("pending") @db.VarChar(12)
  attempts  Int    @default(0)
  nextAttemptAt DateTime? @map("next_attempt_at") @db.DateTime(3)
  lastStatus    Int?      @map("last_status")
  lastError     String?   @map("last_error") @db.VarChar(500)

  createdAt   DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  deliveredAt DateTime? @map("delivered_at") @db.DateTime(3)

  webhook OutboundWebhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@index([webhookId, createdAt])
  @@map("outbound_deliveries")
}


// ============================================================================
// PLUGIN BILLING. F19, development doc 19-pro-lock-and-trial.md
// ============================================================================
// What a creator pays MemberFrame, as opposed to what members pay creators
// (Subscription, Payment above). The license belongs to one Framer project;
// the trial to one creator account and one Framer user, bound to one project.

/// One 7-day trial per creator account, per email, per Framer user, and per
/// Framer project: a match on any one of them means the trial was used.
///
/// No foreign keys and never deleted (PRD section 11.2): deleting an account
/// or a site must not hand out a second trial, so these rows outlive both.
model PluginTrial {
  id              String  @id @default(uuid(7)) @db.Char(36)
  userId          String  @unique @map("user_id") @db.Char(36)
  email           String  @unique @db.VarChar(255)
  framerUserId    String? @unique @map("framer_user_id") @db.VarChar(255)
  framerProjectId String? @unique @map("framer_project_id") @db.VarChar(255)
  /// The project the trial is bound to. Not unique by itself: the project id
  /// above is the stable identity, this is the row it currently points at.
  siteId          String  @map("site_id") @db.Char(36)
  projectName     String  @default("") @map("project_name") @db.VarChar(255)

  startedAt DateTime @map("started_at") @db.DateTime(3)
  endsAt    DateTime @map("ends_at") @db.DateTime(3)
  /// trialing, expired, converted
  status    String   @default("trialing") @db.VarChar(16)

  endingNotifiedAt DateTime? @map("ending_notified_at") @db.DateTime(3)
  endedNotifiedAt  DateTime? @map("ended_notified_at") @db.DateTime(3)

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  @@index([siteId])
  @@index([status, endsAt])
  @@map("plugin_trials")
}

/// A plan bought for one project. A project may have several rows over time
/// (monthly, then lifetime); the newest licensed one is the current plan.
model PluginSubscription {
  id     String @id @default(uuid(7)) @db.Char(36)
  siteId String @map("site_id") @db.Char(36)
  userId String @map("user_id") @db.Char(36)

  /// monthly, yearly, lifetime
  plan   String @db.VarChar(16)
  /// incomplete, active, past_due, canceling, canceled, expired, paid (lifetime)
  status String @db.VarChar(16)

  stripeSubscriptionId  String? @unique @map("stripe_subscription_id") @db.VarChar(255)
  stripePaymentIntentId String? @unique @map("stripe_payment_intent_id") @db.VarChar(255)
  stripePriceId         String? @map("stripe_price_id") @db.VarChar(255)

  /// Integer minor units, like every other amount in this schema.
  amountMinor Int    @map("amount_minor")
  currency    String @db.VarChar(3)

  startedAt          DateTime? @map("started_at") @db.DateTime(3)
  currentPeriodStart DateTime? @map("current_period_start") @db.DateTime(3)
  currentPeriodEnd   DateTime? @map("current_period_end") @db.DateTime(3)
  cancelAtPeriodEnd  Boolean   @default(false) @map("cancel_at_period_end")
  canceledAt         DateTime? @map("canceled_at") @db.DateTime(3)
  cancelReason       String?   @map("cancel_reason") @db.VarChar(500)

  /// The period end a renewal reminder was sent for, so each renewal is
  /// announced once.
  renewalNotifiedFor DateTime? @map("renewal_notified_for") @db.DateTime(3)
  expiredNotifiedAt  DateTime? @map("expired_notified_at") @db.DateTime(3)

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  site     Site            @relation(fields: [siteId], references: [id], onDelete: Cascade)
  payments PluginPayment[]

  @@index([siteId, createdAt])
  @@index([status, currentPeriodEnd])
  @@map("plugin_subscriptions")
}

/// Money received for a plan: the first payment, each renewal, an upgrade, or
/// a lifetime purchase. `creditMinor` is the unused time of the previous plan
/// taken off an upgrade.
model PluginPayment {
  id             String @id @default(uuid(7)) @db.Char(36)
  subscriptionId String @map("subscription_id") @db.Char(36)

  /// initial, renewal, upgrade, lifetime
  kind        String @db.VarChar(16)
  amountMinor Int    @map("amount_minor")
  creditMinor Int    @default(0) @map("credit_minor")
  currency    String @db.VarChar(3)

  stripeInvoiceId       String? @unique @map("stripe_invoice_id") @db.VarChar(255)
  stripePaymentIntentId String? @unique @map("stripe_payment_intent_id") @db.VarChar(255)

  paidAt    DateTime @map("paid_at") @db.DateTime(3)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  subscription PluginSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId, paidAt])
  @@map("plugin_payments")
}

/// Each event from MemberFrame's own Stripe account, recorded once, so a
/// redelivered event changes nothing.
model PlatformWebhookEvent {
  id            String   @id @default(uuid(7)) @db.Char(36)
  stripeEventId String   @unique @map("stripe_event_id") @db.VarChar(255)
  type          String   @db.VarChar(80)
  createdAt     DateTime @default(now()) @map("created_at") @db.DateTime(3)

  @@map("platform_webhook_events")
}

/// The hosted account page's hand-off to the plugin panel. The panel makes a
/// random session id, opens the page in a new tab with it, and polls; when the
/// creator signs in, this row is written, and the panel's next poll turns it
/// into a CreatorSession token, once. Stored, not held in memory as BEAF did,
/// so a restart or a second server loses nothing.
model CreatorAuthHandoff {
  id            String    @id @default(uuid(7)) @db.Char(36)
  sessionIdHash String    @unique @map("session_id_hash") @db.VarChar(255)
  userId        String    @map("user_id") @db.Char(36)
  expiresAt     DateTime  @map("expires_at") @db.DateTime(3)
  consumedAt    DateTime? @map("consumed_at") @db.DateTime(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("creator_auth_handoffs")
}
