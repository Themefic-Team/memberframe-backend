{
  "name": "memberframe-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "MemberFrame API. Node, Express, Prisma, MySQL. Serves the Framer plugin and the canvas components on published sites.",
  "scripts": {
    "dev": "tsx watch --include .env src/server.ts",
    "start": "node dist/server.js",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:check": "tsx scripts/dbCheck.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "migrate": "node dist/migrate.js",
    "start:deploy": "node dist/migrate.js && node dist/server.js",
    "db:studio": "prisma studio",
    "db:seed": "tsx scripts/seed.ts",
    "stripe:prices": "tsx scripts/stripePrices.ts",
    "trial:reset": "tsx scripts/resetTrial.ts"
  },
  "prisma": {
    "seed": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "^6.19.3",
    "@prisma/client": "^6.19.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "geoip-country": "^5.0.202610140208",
    "mariadb": "^3.4.5",
    "nodemailer": "^10.1.0",
    "prisma": "^6.19.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^6.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "ip-address": "^10.7.4"
  }
}
