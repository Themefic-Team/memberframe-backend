# MemberFrame API configuration.
#
# Copy to `.env` and fill in. `.env` is gitignored and must stay that way:
# it holds the database password and the mail credentials.
#
#   cp .env.example .env
#
# `src/config/env.ts` validates every value at boot and refuses to start when
# one is missing or malformed. That is deliberate: a server that starts with a
# broken mail config and discovers it at the first password reset is worse than
# one that will not start.

# ---------------------------------------------------------------------------
# MySQL
# ---------------------------------------------------------------------------
# Prisma reads DATABASE_URL and nothing else, so this one string is the whole
# connection. Format:
#
#   mysql://USER:PASSWORD@HOST:PORT/DATABASE
#
# Laragon defaults: user `root`, empty password, port 3306. An empty password
# is written as nothing between the colon and the at sign.
#
#   mysql://root:@127.0.0.1:3306/memberframe
#
# Use 127.0.0.1 rather than localhost. On Windows, `localhost` can resolve to
# IPv6 ::1 while MySQL listens only on IPv4, which fails with a connection
# refused that looks like the server is down.
#
# If the password contains @ : / ? # or %, percent-encode it. An @ in a
# password splits the URL in the wrong place and the error names the wrong host.
DATABASE_URL="mysql://root:@127.0.0.1:3306/memberframe"

# Create the database first. Prisma migrates tables, it does not create the
# schema itself:
#
#   mysql -u root -e "CREATE DATABASE memberframe CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci;"
#
# Then:
#   npm run db:check      does it connect, and is the server new enough
#   npm run db:migrate    create the tables
#   npm run db:seed       one demo site and tier ladder, for the spike

# Optional. Prisma's connection pool size. Default is num_cpus * 2 + 1, which
# is fine for development and usually too many for cheap shared MySQL hosting,
# where the per-user connection cap can be as low as 25.
# DATABASE_CONNECTION_LIMIT=10

# How the app signs in to MySQL: `prisma` (default, Prisma's engine) or
# `mariadb` (the MariaDB JavaScript driver). Use `mariadb` when the MySQL user
# is on sha256_password: Prisma's engine refuses it with "Unknown
# authentication plugin". Migrations follow it: run `node dist/migrate.js`
# (or `npm run start:deploy`) before the server.
# DATABASE_DRIVER=mariadb

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=4000
NODE_ENV=development

# The public base URL of this API. Goes into emailed links and must match what
# the browser actually calls, or the cookie is set for the wrong host.
#
# For the cookie spike (backend PRD section 2.3) this is the tunnel hostname,
# not localhost: a canvas component on a published Framer site cannot reach
# your machine. Cloudflare Tunnel or ngrok.
API_BASE_URL="http://127.0.0.1:4000"

# ---------------------------------------------------------------------------
# Session cookie
# ---------------------------------------------------------------------------
# SESSION_COOKIE_NAME is what the browser stores. Changing it signs everyone out.
SESSION_COOKIE_NAME=mf_session

# Lifetime in seconds. The short one is used when "Remember me" is unchecked,
# the long one when it is checked. FP-02 section 2.2 asks for 30 days.
SESSION_TTL_SECONDS=86400
SESSION_REMEMBER_TTL_SECONDS=2592000

# Cross-site cookie behaviour. THIS IS THE RISKIEST SETTING IN THE FILE.
#
# A canvas component runs on the creator's domain and calls this API, so the
# session cookie is a third-party cookie. Safari has blocked those by default
# since 2020 and Firefox partitions them. Backend PRD section 4.1 has the
# research and the three mitigations.
#
#   true   SameSite=None; Secure; Partitioned   cross-site, needs HTTPS
#   false  SameSite=Lax                          same-site only, fine for local
#
# Leave it false while testing the API with curl or a local page. Turn it on
# for the spike, which is the only way to find out what Safari does.
SESSION_COOKIE_CROSS_SITE=false

# ---------------------------------------------------------------------------
# Mail
# ---------------------------------------------------------------------------
# MAIL_DRIVER=log writes the message to `storage/mail/` and to the console
# instead of sending it, and records it in `email_logs`. Nothing to configure,
# and the OTP code and the reset link are readable in the file. Use it until
# the flows work, then switch to smtp.
#
#   log   write to storage/mail/ and the console
#   smtp  send through the SMTP settings below
MAIL_DRIVER=log

MAIL_FROM_ADDRESS="no-reply@memberframe.test"
MAIL_FROM_NAME="MemberFrame"

# Only read when MAIL_DRIVER=smtp.
#
# Mailtrap or Mailpit for development, since neither delivers to a real inbox
# and a bug in the reset flow cannot email a stranger.
#   MAIL_HOST=sandbox.smtp.mailtrap.io
#   MAIL_PORT=2525
#
# A real provider for production. If you use Gmail, MAIL_PASSWORD must be an
# app password, not the account password.
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=

# ---------------------------------------------------------------------------
# Password reset
# ---------------------------------------------------------------------------
# Where the emailed link points. {token} is substituted.
#
# CONFLICT C18: this page has to exist on the creator's Framer site and
# nothing in any plan tells them to create it. `<MemberAuth>` detects the
# token in the query string and switches to the reset form, so one instance
# serves both, but the page itself is the creator's to make.
PASSWORD_RESET_URL_TEMPLATE="https://example.framer.website/reset-password?token={token}"

# Fifteen minutes, per FP-02 section 2.3.
PASSWORD_RESET_TTL_SECONDS=900

# ---------------------------------------------------------------------------
# OTP
# ---------------------------------------------------------------------------
OTP_TTL_SECONDS=600
OTP_RESEND_LOCK_SECONDS=60
OTP_MAX_ATTEMPTS=3

# ---------------------------------------------------------------------------
# Lockout and rate limits
# ---------------------------------------------------------------------------
# FP-02 section 3.4 rule 2: five consecutive failures, fifteen minutes.
# Counted per member and cleared on success.
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_SECONDS=900

# PRD section 16.4 requires that OTP send "cannot be used to bomb a third-party
# inbox", which needs a per-IP limit as well as a per-address one. Without the
# IP limit, one attacker walks a list of addresses at one request each.
RATE_LIMIT_WINDOW_SECONDS=900
RATE_LIMIT_MAX_PER_EMAIL=5
RATE_LIMIT_MAX_PER_IP=20

# ---------------------------------------------------------------------------
# Payments (FP-16)
# ---------------------------------------------------------------------------
# 32 random bytes, base64. Encrypts every gateway secret at rest. Required in
# production; empty turns payments off. Generate: openssl rand -base64 32
PAYMENTS_ENCRYPTION_KEY=""
# Development only: the whsec_ secret that `stripe listen` prints, so forwarded
# test events verify without registering a webhook endpoint.
STRIPE_CLI_WEBHOOK_SECRET=""
# How often expired subscriptions and grace periods are swept, in seconds.
PAYMENTS_SWEEP_SECONDS=300

# ---------------------------------------------------------------------------
# Protected downloads (FP-12, Upgrade to Download)
# ---------------------------------------------------------------------------
# local keeps uploads on this server's disk (needs a persistent volume). s3
# uses any S3 compatible bucket: AWS S3, Cloudflare R2, Backblaze B2, MinIO.
ASSET_STORAGE=local
ASSET_STORAGE_DIR=storage/assets
# Largest upload, in bytes. 250 MB.
ASSET_MAX_BYTES=262144000
# How long a download link works, in seconds. PRD F10: 60.
ASSET_LINK_SECONDS=60
# Signs download links. Empty: a random secret per process, fine for one
# server. Behind a load balancer, set the same value everywhere: openssl rand -hex 32
ASSET_SIGNING_SECRET=""
# For ASSET_STORAGE=s3. R2: https://<account>.r2.cloudflarestorage.com, region auto.
ASSET_S3_ENDPOINT=""
ASSET_S3_BUCKET=""
ASSET_S3_REGION="auto"
ASSET_S3_ACCESS_KEY_ID=""
ASSET_S3_SECRET_ACCESS_KEY=""

# ---------------------------------------------------------------------------
# A site's own SMTP (25-custom-smtp.md)
# ---------------------------------------------------------------------------
# Whether a creator's SMTP host may be private (127.0.0.1, 10.x) or use any
# port. Defaults to true outside production (for Mailpit) and false in it.
# SITE_SMTP_ALLOW_PRIVATE_HOSTS=false

# ---------------------------------------------------------------------------
# MemberFrame's own plans: trial, subscriptions (F19, 19-pro-lock-and-trial.md)
# ---------------------------------------------------------------------------
# MemberFrame's Stripe account, NOT a creator's. All five are required in
# production. Prices: monthly $4.99, yearly $49.99, lifetime $99.99, each a
# Stripe Price id (price_...). The panel reads the amounts from Stripe.
#
# The BEAF backend's names work too, so one .env layout serves every Framefic
# plugin: STRIPE_SECRET_KEY, STRIPE_PUBLISHABLE_KEY, STRIPE_WEBHOOK_SECRET,
# STRIPE_PRICE_MONTHLY / _YEARLY / _LIFETIME, GOOGLE_CLIENT_ID / _SECRET, and
# LIFETIME_DEAL_MAX_USERS. A PLATFORM_ / CREATOR_ name wins when both are set.
# Example values ("your-...", "..._here") count as unset.
#
# No price ids yet? `npm run stripe:prices -- --write` creates the three prices
# in the Stripe account above (test keys only, unless -- --live) and writes them here.
#
# Testing the trial end: TRIAL_DURATION_MINUTES=10 and LICENSE_JOB_SECONDS=60,
# then `npm run trial:reset -- you@example.com` for a fresh trial, or
# `-- you@example.com --expire` to end it now.
PLATFORM_STRIPE_SECRET_KEY=""
PLATFORM_STRIPE_PUBLISHABLE_KEY=""
# The endpoint secret of https://<api>/api/webhooks/platform/stripe, listening
# for invoice.paid, invoice.payment_failed, customer.subscription.created,
# customer.subscription.updated, customer.subscription.deleted, and
# payment_intent.succeeded. Locally, STRIPE_CLI_WEBHOOK_SECRET above also works.
PLATFORM_STRIPE_WEBHOOK_SECRET=""
PLATFORM_PRICE_MONTHLY=""
PLATFORM_PRICE_YEARLY=""
PLATFORM_PRICE_LIFETIME=""
# A Stripe promotion code each plan gets on its own (Product catalog, Coupons, the
# coupon, "Add promotion code": the customer facing code). Limit the coupon to the
# plan's product. Shown struck through on that plan's card and applied at checkout,
# unless the creator types another code. A code Stripe does not know, or one whose
# coupon is for another product, is left out (the plan sells at its price).
# Empty, null, none, or false: no discount.
MONTHLY_DISCOUNT_CODE=""
YEARLY_DISCOUNT_CODE=""
LIFETIME_DISCOUNT_CODE=""
# Which plans are sold (yes/no, true/false). Unset: sold. A plan switched off is
# hidden in the panel, refused at checkout and as an upgrade, and needs no
# PLATFORM_PRICE_*. At least one must stay on.
ENABLE_MONTHLY_PLAN=yes
ENABLE_YEARLY_PLAN=yes
ENABLE_LIFETIME_PLAN=yes
# How many lifetime plans are sold before the offer closes.
LIFETIME_MAX=20
TRIAL_DURATION_DAYS=7
# Testing only: a trial this many minutes long. Refused in production.
# TRIAL_DURATION_MINUTES=5
# Signs the seal the Builder puts on each component it inserts, so a copied
# and pasted component locks (27-instance-seal.md). Required in production;
# development uses a fixed value. Generate: openssl rand -base64 32
# INSTANCE_SEAL_SECRET=
# Where Stripe's billing portal sends a creator back to.
BILLING_RETURN_URL="https://framer.com/projects"
# Copies of trial, purchase, and cancellation notices for the team. Empty sends none.
TEAM_NOTIFICATION_EMAIL=""
# Refuse member sign in, checkout, and downloads for a site whose trial or plan
# has ended. Defaults to true (false only under unit tests).
# LICENSE_ENFORCEMENT=true
# How often the trial and renewal job runs, in seconds.
LICENSE_JOB_SECONDS=3600
# Google sign in on the hosted account page: MemberFrame's own OAuth client.
# Redirect URI: https://<api>/api/account/google/callback. Empty: a development
# server shows BEAF's "Simulate Google Sign In" form instead; production hides the button.
CREATOR_GOOGLE_CLIENT_ID=""
CREATOR_GOOGLE_CLIENT_SECRET=""

# ---------------------------------------------------------------------------
# Home promo campaign card (GET /api/plugin/announcement, public)
# docs: memberframe/docs/development-docs/37-promo-campaign-card.md
# ---------------------------------------------------------------------------
# The panel shows only what is set here: no default text, discount, or code.
# A value that does not parse hides the card (the server still starts) and is
# named once in the log. Text is plain text, never HTML. Same names as Hydra.
#
# ANNOUNCEMENT_ENABLED       yes/no or true/false. no hides the card. Unset: on.
# ANNOUNCEMENT_CAMPAIGN_ID   Required for the card. Letters, digits, . _ - (64 max).
#                            A new id starts a fresh offer window on every site and
#                            resets each creator's close and copy state for it.
# ANNOUNCEMENT_TITLE         Required (80 characters max).
# ANNOUNCEMENT_SUBTITLE      Optional (160 max).
# ANNOUNCEMENT_BUTTON_TEXT   Required (40 max). With a coupon: shown after the code is
#                            copied, and opens the plans. Without one: shown at once.
# ANNOUNCEMENT_COUPON_CODE   Optional. Letters, digits, _ - (64 max). Copied exactly as
#                            written. It must exist as an ACTIVE STRIPE PROMOTION CODE on
#                            MemberFrame's own Stripe account (Product catalog, Coupons,
#                            the coupon, "Add promotion code", customer facing code = this
#                            text), with the coupon limited to the plans it is meant for
#                            (50% off Lifetime: apply it to the Lifetime product only).
#                            The creator pastes it in the payment form's "Have a coupon
#                            code?" (Monthly and Lifetime). This text alone discounts nothing.
# ANNOUNCEMENT_COUNTDOWN_ENABLED          yes/no or true/false. Unset: no timer, and the
#                                         card stays until closed.
# ANNOUNCEMENT_DURATION_MINUTES           Required with the countdown. The offer window
#                                         per site: above 0, at most 10080 (7 days).
# ANNOUNCEMENT_COUNTDOWN_VISIBLE_MINUTES  Optional. Show "Offer closes in m:ss" only in
#                                         the window's last minutes. Unset: the whole
#                                         window. Capped at the duration.
# ANNOUNCEMENT_SHOW_TO       Who sees it: a comma list of free (no paid plan: none, trial,
#                            expired), monthly, yearly, lifetime; or all. Default: free.
#                            An unknown name hides the card.
#
# The countdown, close, and copy state live in the creator's browser
# (localStorage), per account, Framer project, and campaign id: no database rows.
# Closing the card, or its countdown running out, hides it for 7 days on that
# site (sooner if the site's trial ends first). The countdown hides the card
# only: the discount ends only when the Stripe promotion code is expired or
# deactivated.
ANNOUNCEMENT_ENABLED=yes
ANNOUNCEMENT_CAMPAIGN_ID=bfcm26
ANNOUNCEMENT_TITLE="Black Friday Offer 2026"
ANNOUNCEMENT_SUBTITLE="Get Flat 50% Off on Lifetime Plan."
ANNOUNCEMENT_BUTTON_TEXT="Grab the Deal Now"
ANNOUNCEMENT_COUPON_CODE=50LTDBFCM26
ANNOUNCEMENT_COUNTDOWN_ENABLED=yes
ANNOUNCEMENT_DURATION_MINUTES=3
ANNOUNCEMENT_COUNTDOWN_VISIBLE_MINUTES=3
ANNOUNCEMENT_SHOW_TO=free,monthly
