# MemberFrame API configuration.
#
# Copy to `.env` and fill in. `.env` is gitignored and must stay that way:
# it holds the database password and the mail credentials.
#
#   cp .env.example .env
#
# `src/config/env.ts` validates every value at boot and refuses to start when
# one is missing or malformed. That is deliberate: a server that starts with a
# broken mail config and discovers it at the first password reset is worse than
# one that will not start.

# ---------------------------------------------------------------------------
# MySQL
# ---------------------------------------------------------------------------
# Prisma reads DATABASE_URL and nothing else, so this one string is the whole
# connection. Format:
#
#   mysql://USER:PASSWORD@HOST:PORT/DATABASE
#
# Laragon defaults: user `root`, empty password, port 3306. An empty password
# is written as nothing between the colon and the at sign.
#
#   mysql://root:@127.0.0.1:3306/memberframe
#
# Use 127.0.0.1 rather than localhost. On Windows, `localhost` can resolve to
# IPv6 ::1 while MySQL listens only on IPv4, which fails with a connection
# refused that looks like the server is down.
#
# If the password contains @ : / ? # or %, percent-encode it. An @ in a
# password splits the URL in the wrong place and the error names the wrong host.
DATABASE_URL="mysql://root:@127.0.0.1:3306/memberframe"

# Create the database first. Prisma migrates tables, it does not create the
# schema itself:
#
#   mysql -u root -e "CREATE DATABASE memberframe CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci;"
#
# Then:
#   npm run db:check      does it connect, and is the server new enough
#   npm run db:migrate    create the tables
#   npm run db:seed       one demo site and tier ladder, for the spike

# Optional. Prisma's connection pool size. Default is num_cpus * 2 + 1, which
# is fine for development and usually too many for cheap shared MySQL hosting,
# where the per-user connection cap can be as low as 25.
# DATABASE_CONNECTION_LIMIT=10

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=4000
NODE_ENV=development

# The public base URL of this API. Goes into emailed links and must match what
# the browser actually calls, or the cookie is set for the wrong host.
#
# For the cookie spike (backend PRD section 2.3) this is the tunnel hostname,
# not localhost: a canvas component on a published Framer site cannot reach
# your machine. Cloudflare Tunnel or ngrok.
API_BASE_URL="http://127.0.0.1:4000"

# ---------------------------------------------------------------------------
# Session cookie
# ---------------------------------------------------------------------------
# SESSION_COOKIE_NAME is what the browser stores. Changing it signs everyone out.
SESSION_COOKIE_NAME=mf_session

# Lifetime in seconds. The short one is used when "Remember me" is unchecked,
# the long one when it is checked. FP-02 section 2.2 asks for 30 days.
SESSION_TTL_SECONDS=86400
SESSION_REMEMBER_TTL_SECONDS=2592000

# Cross-site cookie behaviour. THIS IS THE RISKIEST SETTING IN THE FILE.
#
# A canvas component runs on the creator's domain and calls this API, so the
# session cookie is a third-party cookie. Safari has blocked those by default
# since 2020 and Firefox partitions them. Backend PRD section 4.1 has the
# research and the three mitigations.
#
#   true   SameSite=None; Secure; Partitioned   cross-site, needs HTTPS
#   false  SameSite=Lax                          same-site only, fine for local
#
# Leave it false while testing the API with curl or a local page. Turn it on
# for the spike, which is the only way to find out what Safari does.
SESSION_COOKIE_CROSS_SITE=false

# ---------------------------------------------------------------------------
# Mail
# ---------------------------------------------------------------------------
# MAIL_DRIVER=log writes the message to `storage/mail/` and to the console
# instead of sending it, and records it in `email_logs`. Nothing to configure,
# and the OTP code and the reset link are readable in the file. Use it until
# the flows work, then switch to smtp.
#
#   log   write to storage/mail/ and the console
#   smtp  send through the SMTP settings below
MAIL_DRIVER=log

MAIL_FROM_ADDRESS="no-reply@memberframe.test"
MAIL_FROM_NAME="MemberFrame"

# Only read when MAIL_DRIVER=smtp.
#
# Mailtrap or Mailpit for development, since neither delivers to a real inbox
# and a bug in the reset flow cannot email a stranger.
#   MAIL_HOST=sandbox.smtp.mailtrap.io
#   MAIL_PORT=2525
#
# A real provider for production. If you use Gmail, MAIL_PASSWORD must be an
# app password, not the account password.
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=

# ---------------------------------------------------------------------------
# Password reset
# ---------------------------------------------------------------------------
# Where the emailed link points. {token} is substituted.
#
# CONFLICT C18: this page has to exist on the creator's Framer site and
# nothing in any plan tells them to create it. `<MemberAuth>` detects the
# token in the query string and switches to the reset form, so one instance
# serves both, but the page itself is the creator's to make.
PASSWORD_RESET_URL_TEMPLATE="https://example.framer.website/reset-password?token={token}"

# Fifteen minutes, per FP-02 section 2.3.
PASSWORD_RESET_TTL_SECONDS=900

# ---------------------------------------------------------------------------
# OTP
# ---------------------------------------------------------------------------
OTP_TTL_SECONDS=600
OTP_RESEND_LOCK_SECONDS=60
OTP_MAX_ATTEMPTS=3

# ---------------------------------------------------------------------------
# Lockout and rate limits
# ---------------------------------------------------------------------------
# FP-02 section 3.4 rule 2: five consecutive failures, fifteen minutes.
# Counted per member and cleared on success.
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_SECONDS=900

# PRD section 16.4 requires that OTP send "cannot be used to bomb a third-party
# inbox", which needs a per-IP limit as well as a per-address one. Without the
# IP limit, one attacker walks a list of addresses at one request each.
RATE_LIMIT_WINDOW_SECONDS=900
RATE_LIMIT_MAX_PER_EMAIL=5
RATE_LIMIT_MAX_PER_IP=20
